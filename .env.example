# ==============================================================
# PPOPLINK Backend - Environment Variables
# ==============================================================
# Copy this file to .env.local for development:
#   cp .env.example .env.local
#
# For production (Railway), set these in the Railway dashboard.
# ==============================================================

# --- App Configuration ---
APP_ENV=dev
APP_PORT=8005
DEBUG=True

# --- Database (Railway PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Storage (Railway Buckets - S3 compatible) ---
S3_ENDPOINT_URL=https://your-bucket.storage.railway.app
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=ppoplink
S3_REGION=auto

# --- CDN (public-buckets webserver) ---
CDN_BASE_URL=https://webserver-xxx.up.railway.app
CDN_BUCKET_ALIAS=ppoplink

# --- PPOP Auth (SSO) ---
PPOP_AUTH_API_URL=https://auth-api.yourdomain.com
PPOP_AUTH_CLIENT_URL=https://auth.yourdomain.com
PPOP_AUTH_CLIENT_ID=your-client-id
PPOP_AUTH_CLIENT_SECRET=your-client-secret
PPOP_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
PPOP_AUTH_JWKS_URI=https://auth-api.yourdomain.com/.well-known/jwks.json
PPOP_AUTH_SERVICE_CODE=ppop-link
PPOP_AUTH_ADMIN_API_KEY=your-admin-api-key

# --- Server ---
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PPOP_AUTH_CLIENT_ORIGIN=

# --- Cookie Settings ---
# dev: lax / prod: none (for cross-origin)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Logging ---
LOG_LEVEL=INFO

# --- Developer IPs (comma separated) ---
DEVELOPER_IPS=

# --- Discord Webhook (security alerts) ---
DISCORD_WEBHOOK_URL=
