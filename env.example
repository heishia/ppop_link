# ===========================================
# PPOPLINK Backend - Railway 배포용 환경변수
# ===========================================

# -------------------------------------------
# App Configuration
# -------------------------------------------
APP_ENV=prod
APP_NAME=PPOPLINK
APP_PORT=8005

# -------------------------------------------
# Supabase (Database)
# -------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# -------------------------------------------
# PPOP Auth (SSO)
# -------------------------------------------
PPOP_AUTH_API_URL=https://ppop-auth-server.up.railway.app
PPOP_AUTH_CLIENT_URL=https://ppop-auth-client.up.railway.app
PPOP_AUTH_CLIENT_ID=
PPOP_AUTH_CLIENT_SECRET=
PPOP_AUTH_REDIRECT_URI=https://ppoplink.up.railway.app/auth/callback
PPOP_AUTH_JWKS_URI=https://ppop-auth-server.up.railway.app/.well-known/jwks.json
PPOP_AUTH_SERVICE_CODE=ppop-link
PPOP_AUTH_ADMIN_API_KEY=

# -------------------------------------------
# CORS
# -------------------------------------------
CORS_ORIGINS=https://ppop-auth-client.up.railway.app,https://ppoplink.up.railway.app
PPOP_AUTH_CLIENT_ORIGIN=https://ppop-auth-client.up.railway.app

# -------------------------------------------
# Server
# -------------------------------------------
DEBUG=false
API_PREFIX=/api

# -------------------------------------------
# Storage
# -------------------------------------------
STORAGE_BUCKET_PROFILES=profiles
STORAGE_BUCKET_BACKGROUNDS=backgrounds
MAX_FILE_SIZE_MB=5

# -------------------------------------------
# Plan Limits
# -------------------------------------------
FREE_MAX_LINKS=6
FREE_MAX_SOCIAL_LINKS=5

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO

# -------------------------------------------
# Sentry (선택)
# -------------------------------------------
SENTRY_DSN=
